{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode-go": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Release Notes Gateway",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1",
        "apiKey": "{env:OPENCODE_GO_API_KEY}"
      },
      "models": {
        "minimax-m3": {
          "name": "MiniMax-M3"
        }
      }
    }
  },
  "permission": {
    "*": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny"
    },
    "edit": {
      "*": "deny",
      ".release-notes/RELEASE_NOTES_*.md": "allow"
    },
    "skill": {
      "*": "deny",
      "dsh-release-notes": "allow",
      "dsh-release-notes:validate": "allow"
    }
  }
}
