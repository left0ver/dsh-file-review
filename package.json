{
  "name": "dsh-file-review",
  "version": "0.6.0",
  "description": "Review DeepSeek Harness file changes, support dsh-better-sidebar",
  "keywords": [
    "code-review",
    "deepseek-harness",
    "diff",
    "dsh-plugin"
  ],
  "homepage": "https://github.com/left0ver/dsh-file-review#readme",
  "bugs": {
    "url": "https://github.com/left0ver/dsh-file-review/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/left0ver/dsh-file-review.git"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "assets/preview.png",
    "assets/preview_with_better_sidebar.png"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/types/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/types/remote.d.ts",
      "default": "./lib/remote.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "check:readme-i18n": "node scripts/verify-readme-i18n.mjs",
    "update:readme-i18n": "node scripts/verify-readme-i18n.mjs --write",
    "clean": "node scripts/clean-lib.mjs",
    "build:types": "tsc --emitDeclarationOnly --outDir lib/types",
    "build": "npm run clean && npm run build:types && tsdown",
    "codecheck": "npm run fmt && npm run lint",
    "typecheck": "tsc --noEmit",
    "test:smoke": "vitest run tests/smoke.spec.ts",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:standalone": "npm run build && E2E_VARIANT=standalone playwright test --project=standalone",
    "test:e2e:better-sidebar": "npm run build && E2E_VARIANT=better-sidebar playwright test --project=better-sidebar",
    "adapter:e2e": "sh adapter_script/run-e2e.sh",
    "adapter:start-dsh": "sh adapter_script/start-dsh.sh",
    "test": "npm run build && vitest run && npm run test:pack",
    "test:pack": "node scripts/verify-pack.mjs",
    "prepack": "npm run codecheck && npm run typecheck && npm test",
    "release": "npm publish --registry=https://registry.npmjs.org/"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "diff": "^9.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-atomic-write": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-brand": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-connection": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-store": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-code-runtime": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-invariants": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-scope": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-typert-registry": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-user-approval": "0.1.2-alpha.5",
    "@midscene/web": "^1.12.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "lightningcss": "^1.32.0",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "playwright": "^1.62.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": ">=0.1.2-alpha.5 <0.1.2",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.2-alpha.5 <0.1.2",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.2-alpha.5 <0.1.2",
    "@deepseek-ai/dsh-atomic-write": ">=0.1.2-alpha.5 <0.1.2",
    "@deepseek-ai/dsh-client-connection": ">=0.1.2-alpha.5 <0.1.2",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-alpha.5 <0.1.2",
    "@deepseek-ai/dsh-client-store": ">=0.1.2-alpha.5 <0.1.2",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.1.2-alpha.5 <0.1.2",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.2-alpha.5 <0.1.2",
    "@deepseek-ai/dsh-client-ui-input-trigger": ">=0.1.2-alpha.5 <0.1.2",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.2-alpha.5 <0.1.2",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.2-alpha.5 <0.1.2",
    "@deepseek-ai/dsh-client-ui-session": ">=0.1.2-alpha.5 <0.1.2",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.2-alpha.5 <0.1.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": ">=0.1.2-alpha.5 <0.1.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-alpha.5 <0.1.2",
    "@deepseek-ai/dsh-llm": ">=0.1.2-alpha.5 <0.1.2",
    "@deepseek-ai/dsh-session": ">=0.1.2-alpha.5 <0.1.2",
    "@deepseek-ai/dsh-settings": ">=0.1.2-alpha.5 <0.1.2",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.2-alpha.5 <0.1.2",
    "@deepseek-ai/dsh-tools": ">=0.1.2-alpha.5 <0.1.2",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.2-alpha.5 <0.1.2",
    "@deepseek-ai/dsh-typert-registry": ">=0.1.2-alpha.5 <0.1.2",
    "dsh-better-sidebar": ">=0.12.1 <0.18.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "dsh": {
    "adapter": {
      "cliVersion": "0.1.2-alpha.5",
      "betterSidebarVersion": "0.18.0-alpha.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  }
}
