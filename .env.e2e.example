# Midscene 模型变量完整说明：
# https://midscenejs.com/model-config
# 支持的模型、MODEL_NAME 与 MODEL_FAMILY 对照及 Codex App Server 配置：
# https://midscenejs.com/model-common-config

# 模型服务入口。普通 OpenAI 兼容服务填写以版本号结尾的地址（例如 /v1），
# 不要追加 /chat/completions。codex://app-server 会复用本机 `codex login` 的 OAuth 登录态。
MIDSCENE_MODEL_BASE_URL=codex://app-server

# 实际调用的模型标识；使用 Codex App Server 时，应填写 Codex 当前提供的模型名称。
MIDSCENE_MODEL_NAME=gpt-5.6-luna

# 模型系列，Midscene 据此选择视觉定位和坐标处理适配；必须与 MODEL_NAME 所属系列一致。
# GPT-5.4 及更新的 GPT-5 系列（包括 gpt-5.6-luna）使用 gpt-5。
MIDSCENE_MODEL_FAMILY=gpt-5
